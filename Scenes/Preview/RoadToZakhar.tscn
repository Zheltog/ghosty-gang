[sub_resource type="GDScript" id="GDScript_j35rs"]
script/source = "extends SceneDialogManager

const HUM_MUSIC := \"res://Assets/Audio/Music/hum.wav\"
const WATER_SOUND := \"res://Assets/Audio/Sounds/water_kitchen.mp3\"
const STORAGE_HUM_FADE_SECONDS := 8.0
const KITCHEN_BUSY := \"res://Files/SceneDialogs/Ink/kitchen_busy.ink\"
@onready var blackout: BlackoutEffect = $\"../Blackout\"
@onready var blackout_keep_dialog: BlackoutEffect = $\"../BlackoutKeepDialog\"

var gun_drawn := false
var _storage_hum := false

func process_event(event: String) -> void:
	if event == \"storage_opened\":
		on_storage_opened()
		return
	if event == \"kitchen_blocked\":
		_on_kitchen_blocked()
		return
	if event == \"equip_gun\":
		_on_equip_gun()
		return
	if event == \"unequip_gun\":
		_on_unequip_gun()
		return
	if event == \"silence_kitchen\":
		_silence_kitchen()
		return
	if event == \"reveal_rag\":
		_reveal_room_child(\"bathroom\", \"Rag\")
		return
	if event == \"reveal_tea\":
		_reveal_room_child(\"kitchen_couch\", \"Tea\")
		return
	if event == \"reveal_empty_tea\":
		_reveal_room_child(\"kitchen_couch\", \"EmptyTea\")
		return
	if event == \"mark_glass_eye\":
		mark_glass_eye()
		return
	if event == \"story_storage_fire_finished\":
		game_over()
	super.process_event(event)

func game_over() -> void:
	blackout.effect_blackout()

func set_gun_drawn(drawn: bool) -> void:
	if gun_drawn == drawn:
		return
	gun_drawn = drawn
	InkVariableStore.set_value(\"gun_drawn\", drawn)
	if drawn:
		CommonAudioProcessor.transition_music(HUM_MUSIC)
	elif not _storage_hum:
		CommonAudioProcessor.transition_music(SceneLoader.DAY_MUSIC)

func on_storage_opened() -> void:
	if _storage_hum:
		return
	_storage_hum = true
	CommonAudioProcessor.transition_music(HUM_MUSIC, STORAGE_HUM_FADE_SECONDS)

func mark_glass_eye() -> void:
	InkVariableStore.set_value(\"has_glass_eye\", true)

func mark_passports_seen() -> void:
	InkVariableStore.set_value(\"saw_passports\", true)

func store_gun_drawn() -> void:
	InkVariableStore.set_value(\"gun_drawn\", gun_drawn)

func _on_kitchen_blocked() -> void:
	if DialogController.is_dialog_active():
		return
	if dialog_controller == null:
		printerr(\"SceneStates: no DialogController\")
		return
	dialog_controller.start_story(KITCHEN_BUSY)

func _on_equip_gun() -> void:
	set_gun_drawn(true)
	if DialogController.is_dialog_active():
		return
	if flag(\"engineer_dead\"):
		return
	if dialog_controller == null:
		printerr(\"SceneStates: no DialogController\")
		return
	dialog_controller.start_story(DialogPathConstants.GUN_EQUIP)

func _on_unequip_gun() -> void:
	set_gun_drawn(false)

func _silence_kitchen() -> void:
	if not CommonAudioProcessor.has_looped_sound(WATER_SOUND):
		return
	var command := AudioSoundLoopedCoomand.new()
	command.instant = true
	command.resource_name = WATER_SOUND
	command.post_action = AudioConstants.STOP
	CommonAudioProcessor.process_sound_looped(command)

func _reveal_room_child(room_name: String, child_name: String) -> void:
	var scene := HouseSceneBase.current_house_scene as HouseScenePreview
	if scene == null:
		printerr(\"SceneStates: no house scene\")
		return
	scene.set_room_child_visible(room_name, child_name, true)

func suspicion() -> int:
	return int(InkVariableStore.get_value(\"suspicion\", 0))

func store_arrival_flags() -> void:
	var shelf_open := bool(StateManager.get_state(CustomBookshelfSceneItemUI.STATE_OPEN, false))
	InkVariableStore.set_value(\"closet_open\", shelf_open)

func engineer() -> SceneCharacter:
	var scene := HouseSceneBase.current_house_scene as HouseScenePreview
	if scene == null:
		return null
	var character := scene.find_character(\"engineer\")
	if character:
		return character
	return scene.get_node_or_null(\"Characters/Engineer\") as SceneCharacter

func show_engineer(location: String, emotion: String = \"\") -> void:
	var character := engineer()
	if character == null:
		printerr(\"SceneStates: no engineer\")
		return
	var root := character.get_parent()
	if root:
		root.visible = true
	if not emotion.is_empty():
		character.set_emotion(emotion)
	character.set_location(location)
"

[sub_resource type="GDScript" id="GDScript_wm53h"]
script/source = "extends SceneDialogState

func activate() -> void:
	super.activate()
	play(DialogPathConstants.ROAD_TO_ZAKHAR_WASTELAND)
	print(\"wasteland done\")

func process_event(event: String) -> void:
	if event == \"room_street_1\":
		activate_next(0)
"

