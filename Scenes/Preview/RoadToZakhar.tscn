[sub_resource type="GDScript" id="GDScript_j35rs"]
script/source = "extends SceneDialogManager

const HUM_MUSIC := \"res://Assets/Audio/Music/hum.wav\"
const WATER_SOUND := \"res://Assets/Audio/Sounds/water_kitchen.mp3\"
const STORAGE_HUM_FADE_SECONDS := 8.0
const KITCHEN_BUSY := \"res://Files/SceneDialogs/Ink/kitchen_busy.ink\"
@onready var blackout: BlackoutEffect = $\"../Blackout\"
@onready var blackout_keep_dialog: BlackoutEffect = $\"../BlackoutKeepDialog\"

var gun_drawn := false
var _storage_hum := false

func process_event(event: String) -> void:
	if event == \"storage_opened\":
		on_storage_opened()
		return
	if event == \"kitchen_blocked\":
		_on_kitchen_blocked()
		return
	if event == \"equip_gun\":
		_on_equip_gun()
		return
	if event == \"unequip_gun\":
		_on_unequip_gun()
		return
	if event == \"silence_kitchen\":
		_silence_kitchen()
		return
	if event == \"reveal_rag\":
		_reveal_room_child(\"bathroom\", \"Rag\")
		return
	if event == \"reveal_tea\":
		_reveal_room_child(\"kitchen_couch\", \"Tea\")
		return
	if event == \"reveal_empty_tea\":
		_reveal_room_child(\"kitchen_couch\", \"EmptyTea\")
		return
	if event == \"mark_glass_eye\":
		mark_glass_eye()
		return
	if event == \"story_storage_fire_finished\":
		game_over()
	super.process_event(event)

func game_over() -> void:
	blackout.effect_blackout()

func set_gun_drawn(drawn: bool) -> void:
	if gun_drawn == drawn:
		return
	gun_drawn = drawn
	InkVariableStore.set_value(\"gun_drawn\", drawn)
	if drawn:
		CommonAudioProcessor.transition_music(HUM_MUSIC)
	elif not _storage_hum:
		CommonAudioProcessor.transition_music(SceneLoader.DAY_MUSIC)

func on_storage_opened() -> void:
	if _storage_hum:
		return
	_storage_hum = true
	CommonAudioProcessor.transition_music(HUM_MUSIC, STORAGE_HUM_FADE_SECONDS)

func mark_glass_eye() -> void:
	InkVariableStore.set_value(\"has_glass_eye\", true)

func mark_passports_seen() -> void:
	InkVariableStore.set_value(\"saw_passports\", true)

func store_gun_drawn() -> void:
	InkVariableStore.set_value(\"gun_drawn\", gun_drawn)

func _on_kitchen_blocked() -> void:
	if DialogController.is_dialog_active():
		return
	if dialog_controller == null:
		printerr(\"SceneStates: no DialogController\")
		return
	dialog_controller.start_story(KITCHEN_BUSY)

func _on_equip_gun() -> void:
	set_gun_drawn(true)
	if DialogController.is_dialog_active():
		return
	if flag(\"engineer_dead\"):
		return
	if dialog_controller == null:
		printerr(\"SceneStates: no DialogController\")
		return
	dialog_controller.start_story(DialogPathConstants.GUN_EQUIP)

func _on_unequip_gun() -> void:
	set_gun_drawn(false)

func _silence_kitchen() -> void:
	if not CommonAudioProcessor.has_looped_sound(WATER_SOUND):
		return
	var command := AudioSoundLoopedCoomand.new()
	command.instant = true
	command.resource_name = WATER_SOUND
	command.post_action = AudioConstants.STOP
	CommonAudioProcessor.process_sound_looped(command)

func _reveal_room_child(room_name: String, child_name: String) -> void:
	var scene := HouseSceneBase.current_house_scene as HouseScenePreview
	if scene == null:
		printerr(\"SceneStates: no house scene\")
		return
	scene.set_room_child_visible(room_name, child_name, true)

func suspicion() -> int:
	return int(InkVariableStore.get_value(\"suspicion\", 0))

func store_arrival_flags() -> void:
	var shelf_open := bool(StateManager.get_state(CustomBookshelfSceneItemUI.STATE_OPEN, false))
	InkVariableStore.set_value(\"closet_open\", shelf_open)

func engineer() -> SceneCharacter:
	var scene := HouseSceneBase.current_house_scene as HouseScenePreview
	if scene == null:
		return null
	var character := scene.find_character(\"engineer\")
	if character:
		return character
	return scene.get_node_or_null(\"Characters/Engineer\") as SceneCharacter

func show_engineer(location: String, emotion: String = \"\") -> void:
	var character := engineer()
	if character == null:
		printerr(\"SceneStates: no engineer\")
		return
	var root := character.get_parent()
	if root:
		root.visible = true
	if not emotion.is_empty():
		character.set_emotion(emotion)
	character.set_location(location)
"

[sub_resource type="GDScript" id="GDScript_wm53h"]
script/source = "extends SceneDialogState

func activate() -> void:
	super.activate()
	play(DialogPathConstants.ROAD_TO_ZAKHAR_WASTELAND)
	print(\"wasteland done\")

func process_event(event: String) -> void:
	if event == \"story_inside_house_finished\":
		scene_dialog_manager.show_engineer(\"kitchen\")
	elif event == \"story_passport_finished\":
		if scene_dialog_manager.has_method(\"mark_passports_seen\"):
			scene_dialog_manager.mark_passports_seen()
		activate_next(0)
"

[sub_resource type="GDScript" id="GDScript_h8ddq"]
script/source = "extends SceneDialogState

const RETURN_SECONDS := 6.0
const NIGHT_MUSIC := \"res://Assets/Audio/Music/Ночь.mp3\"
const NIGHT_FADE_SECONDS := 8.0
const INSIDE_ROOMS: Array[String] = [\"storage\", \"exit_from_storage\"]

func activate() -> void:
	super.activate()
	var countdown := scene_dialog_manager.timer
	if countdown == null:
		printerr(\"PassportTimer: no GameTimer\")
		return
	countdown.start(RETURN_SECONDS, _on_timer_timeout, true)

func _on_timer_timeout() -> void:
	var scene := house()
	if scene == null:
		printerr(\"PassportTimer: no house scene\")
		return
	scene_dialog_manager.show_engineer(\"living_room\")
	CommonAudioProcessor.transition_music(NIGHT_MUSIC, NIGHT_FADE_SECONDS)
	if INSIDE_ROOMS.has(scene.current_room):
		scene.set_movement_locked(true)
		activate_next(0)
	else:
		activate_next(1)
"

[sub_resource type="GDScript" id="GDScript_vwr50"]
script/source = "extends SceneDialogState

const FIRE_SOUND := \"res://Assets/Audio/Sounds/fire.mp3\"
const KEY_TURN_SOUND := \"res://Assets/Audio/Sounds/key_turning.mp3\"
const FIRE_DELAY := 8.0
const GAMEOVER_DELAY := 20.0
const EXIT_CLOSED_BACKGROUND := preload(\"res://Assets/Sprites/Backgrounds/exit_from_storage_dark_closed.png\")
const EXIT_CLOSED_LIGHT_INDEX := 15
const EXIT_CLOSED_B_LIGHT_INDEX := 16

func activate() -> void:
	super.activate()
	_seal_storage()
	scene_dialog_manager.call_delayed(_start_fire, FIRE_DELAY)
	scene_dialog_manager.call_delayed(_start_fire, FIRE_DELAY)

func _start_fire() -> void:
	play_looped(FIRE_SOUND)

func _seal_storage() -> void:
	var scene := house()
	if scene == null:
		printerr(\"StorageFire: no house scene\")
		return
	scene.set_room_child_visible(\"storage\", \"ToLivingRoom\", false)
	scene.set_room_child_visible(\"exit_from_storage\", \"ToLivingRoomToExit\", false)
	_close_storage_exit()
	scene.lock_room(\"living_room_to_exit\", _stay_inside)

var _once = false
func _stay_inside() -> void:
	if !_once:
		play(DialogPathConstants.STORAGE_FIRE)
		_once = true

func _close_storage_exit() -> void:
	var scene := house()
	if scene == null:
		return
	var shelf := scene.find_child(\"Shelfs\", true, false) as CustomBookshelfSceneItemUI
	if shelf:
		shelf.lock_closed()
	var background := scene.room_child(\"exit_from_storage\", \"Background\") as Sprite2D
	if background == null:
		printerr(\"StorageFire: exit_from_storage background is missing\")
		return
	background.texture = EXIT_CLOSED_BACKGROUND
	background.set_instance_shader_parameter(\"lighted_index\", EXIT_CLOSED_LIGHT_INDEX)
	get_tree().create_timer(1.0).timeout.connect(_dim_storage_exit.bind(background))

func _dim_storage_exit(background: Sprite2D) -> void:
	if not is_instance_valid(background):
		return
	var command := AudioSoundCommand.new()
	command.instant = true
	command.resource_name = KEY_TURN_SOUND
	CommonAudioProcessor.process_sound(command)
	background.set_instance_shader_parameter(\"lighted_index\", EXIT_CLOSED_B_LIGHT_INDEX)
"

[sub_resource type="GDScript" id="GDScript_2ncxo"]
script/source = "extends SceneDialogState

func activate() -> void:
	super.activate()
	var scene := house()
	if scene:
		scene.load_room(\"living_room\")
	scene_dialog_manager.show_engineer(\"living_room\", \"stand_tea\")
	scene_dialog_manager.store_arrival_flags()
	if scene_dialog_manager.has_method(\"store_gun_drawn\"):
		scene_dialog_manager.store_gun_drawn()
	play(DialogPathConstants.TEA_READY)

func process_event(event: String) -> void:
	if event != \"story_engineer_tea_ready_finished\":
		return
	if scene_dialog_manager.flag(\"engineer_dead\"):
		activate_next(0)
	else:
		activate_next(1)
"

[sub_resource type="GDScript" id="GDScript_o2sri"]
script/source = "extends SceneDialogState

@export var blackout_keep_text : BlackoutEffect

func activate() -> void:
	super.activate()
	await blackout_keep_text.effect_blackout()
	play(DialogPathConstants.STREET)
"

[sub_resource type="GDScript" id="GDScript_iyokh"]
script/source = "extends SceneDialogState

var _entered_kitchen := false
var _entered_couch := false
var _sit_said := false

func activate() -> void:
	super.activate()
	var scene := house()
	if scene:
		scene.unlock_room(\"kitchen\")
	scene_dialog_manager.show_engineer(\"kitchen\", \"stand_tea\")

func process_event(event: String) -> void:
	if event == \"room_kitchen\":
		_entered_kitchen = true
	elif event == \"room_kitchen_couch\":
		_entered_couch = true

func check_condition() -> int:
	if DialogController.is_dialog_active():
		return -1
	if _entered_kitchen and not _sit_said:
		_sit_said = true
		play(DialogPathConstants.SIT)
		return -1
	if _entered_couch:
		return 0
	return -1
"

[sub_resource type="GDScript" id="GDScript_n2yyr"]
script/source = "extends SceneDialogState

const SPILL_SUSPICION := 4

func activate() -> void:
	super.activate()
	scene_dialog_manager.show_engineer(\"kitchen_couch\")
	if scene_dialog_manager.suspicion() >= SPILL_SUSPICION:
		activate_next(0)
	else:
		activate_next(1)
"

[sub_resource type="GDScript" id="GDScript_tqmps"]
script/source = "extends SceneDialogState

func activate() -> void:
	super.activate()
	play(DialogPathConstants.SPILL_TEA)

func process_event(event: String) -> void:
	if event != \"story_engineer_spil_tea_finished\":
		return
	if scene_dialog_manager.flag(\"engineer_dead\"):
		activate_next(1)
	elif scene_dialog_manager.flag(\"fetching_rag\"):
		activate_next(0)
	else:
		printerr(\"SpillTea: story ended without a follow-up flag\")
"

[sub_resource type="GDScript" id="GDScript_2oea7"]
script/source = "extends SceneDialogState

var _on_the_couch := false

func activate() -> void:
	super.activate()
	var scene := house()
	_on_the_couch = scene != null and scene.current_room == \"kitchen\"

func process_event(event: String) -> void:
	if event == \"room_kitchen_couch\":
		_on_the_couch = true
	elif event.begins_with(\"room_\"):
		_on_the_couch = false

func check_condition() -> int:
	if not _on_the_couch or DialogController.is_dialog_active():
		return -1
	if not _has_rag():
		return -1
	return 0

func _has_rag() -> bool:
	var scene := house()
	if scene == null or scene.scene_object_manager == null:
		return false
	var inventory := scene.scene_object_manager.inventory
	if inventory == null:
		return false
	return inventory.has_item(InventoryItemGenerator.INVENTORY_ITEM.RAG)
"

[sub_resource type="GDScript" id="GDScript_oingf"]
script/source = "extends SceneDialogState

func activate() -> void:
	super.activate()
	play(DialogPathConstants.INTERVIEW)

func process_event(event: String) -> void:
	if event == \"reveal_glass_eye\":
		house().set_room_child_visible(\"kitchen_couch\", \"GlassEye\", true)
		return
	if event == \"hide_glass_eye\":
		house().set_room_child_visible(\"kitchen_couch\", \"GlassEye\", false)
		return
	if event != \"story_engineer_interview_finished\":
		return
	if scene_dialog_manager.flag(\"engineer_dead\") or scene_dialog_manager.flag(\"engineer_kicked\"):
		activate_next(0)
	elif scene_dialog_manager.flag(\"engineer_poison\"):
		activate_next(1)
	elif scene_dialog_manager.flag(\"engineer_sleep\"):
		activate_next(2)
	else:
		printerr(\"Interview: story ended without a follow-up flag\")
"

[sub_resource type="GDScript" id="GDScript_btro1"]
script/source = "extends SceneDialogState

const TORTURE_MUSIC := \"res://Assets/Audio/Music/FUCK.mp3\"
const EXIT_CLOSED_BACKGROUND := preload(\"res://Assets/Sprites/Backgrounds/exit_from_storage_dark.png\")
const EXIT_CLOSED_LIGHT_INDEX := 15

@export var blackout: BlackoutEffect
@export var stab_effect: EyeCutEffect
@export var engineer: SceneCharacter

func activate() -> void:
	super.activate()
	var scene := house()
	scene.set_movement_locked(true)
	await blackout.effect_blackout()
	CommonAudioProcessor.transition_music(TORTURE_MUSIC)
	if scene == null:
		printerr(\"Torture: no house scene\")
		return
	scene.load_room(\"exit_from_storage\")
	_close_storage_exit(scene)
	_lock_inventory(scene)
	_place_engineer()
	await blackout.back_to_normal()
	play(DialogPathConstants.TORTURE)

func process_event(_event: String) -> void:
	if _event == \"story_torture_finished\":
		await blackout.effect_blackout()
	if _event == \"stab\":
		stab()

func _place_engineer() -> void:
	var root := engineer.get_parent()
	if root:
		root.visible = true
	engineer.set_emotion(\"stand_suspicious\")
	engineer.set_location(\"exit_from_storage\")
	#TODO: REMOVE:
	engineer.modulate = Color.from_rgba8(110,100,100)

func _close_storage_exit(scene: HouseScenePreview) -> void:
	var background := scene.room_child(\"exit_from_storage\", \"Background\") as Sprite2D
	if background == null:
		printerr(\"Torture: exit_from_storage background is missing\")
		return
	background.texture = EXIT_CLOSED_BACKGROUND
	background.set_instance_shader_parameter(\"lighted_index\", EXIT_CLOSED_LIGHT_INDEX)

func _lock_inventory(scene: HouseScenePreview) -> void:
	if scene.scene_object_manager == null or scene.scene_object_manager.inventory == null:
		printerr(\"Torture: no inventory\")
		return
	scene.scene_object_manager.inventory.set_locked(true)

func cut_eye() -> void:
	stab_effect.cut_eye()

func stab() -> void:
	stab_effect.stab()

func move_needle() -> void:
	stab_effect.move_needle()
"

[sub_resource type="GDScript" id="GDScript_0qdbh"]
script/source = "extends SceneDialogState

func activate() -> void:
	super.activate()
	play(DialogPathConstants.BEDDING)

func process_event(event: String) -> void:
	if event != \"story_bedding_finished\":
		return
	activate_next(0)
"

[sub_resource type="GDScript" id="GDScript_8hvcg"]
script/source = "extends SceneDialogState

@export var blackout_keep_dialog : BlackoutEffect

func activate() -> void:
	super.activate()
	await blackout_keep_dialog.effect_blackout()
	play(DialogPathConstants.DREAM)

func process_event(event: String) -> void:
	if event != \"story_dream_finished\":
		return
	await blackout_keep_dialog.back_to_normal()
	activate_next(0)
"

[sub_resource type="GDScript" id="GDScript_d0v3y"]
script/source = "extends SceneDialogState

const SUSPITION_THRESHOLD := 3

func activate() -> void:
	super.activate()
	var engineer = scene_dialog_manager.engineer() as SceneCharacter
	engineer.set_emotion(\"stand_suspicious\")
	play(DialogPathConstants.WAKE)

func process_event(event: String) -> void:
	if event != \"story_wake_finished\":
		return
	if InkVariableStore.get_value(\"suspition\", 0) >= SUSPITION_THRESHOLD and !scene_dialog_manager.flag(\"engineer_dead\"):
		activate_next(0)
	else:
		activate_next(1)
"

